{
  "name": "raygo-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "RAYGO - Autonomous Revenue Intelligence & AI-to-AI Autonomous Commerce Engine",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
